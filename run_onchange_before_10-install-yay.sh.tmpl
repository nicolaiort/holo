#!/bin/bash
# yay baseline hash: {{ include "packages/yay.txt" | sha256sum }}
# yay host hash ({{ .chezmoi.hostname }}): {{ $hostFile := print "packages/yay." .chezmoi.hostname ".txt" }}{{ if stat (joinPath .chezmoi.sourceDir $hostFile) }}{{ include $hostFile | sha256sum }}{{ else }}no-host-file{{ end }}
# Deklarative yay-Pakete via chezmoi (run_onchange_before).
# Läuft automatisch bei `chezmoi apply`, sobald sich packages/yay.txt
# oder packages/yay.<hostname>.txt ändert.
# Basis: packages/yay.txt (alle Hosts) + optional packages/yay.<hostname>.txt (dieser Host).
set -eu

BASE_FILE="{{ .chezmoi.sourceDir }}/packages/yay.txt"
HOST_FILE="{{ .chezmoi.sourceDir }}/packages/yay.{{ .chezmoi.hostname }}.txt"

if [ ! -f "$BASE_FILE" ]; then
  echo "yay baseline: $BASE_FILE nicht gefunden, skip."
  exit 0
fi

FILES=("$BASE_FILE")
if [ -f "$HOST_FILE" ]; then
  FILES+=("$HOST_FILE")
  echo "yay baseline: nutze zusätzlich $HOST_FILE."
fi

mapfile -t PKGS < <(cat "${FILES[@]}" | grep -vE '^\s*(#|$)' | awk 'NF && !seen[$0]++' || true)
if [ "${#PKGS[@]}" -eq 0 ]; then
  echo "yay baseline: keine Pakete in ${FILES[*]}."
  exit 0
fi

if ! command -v yay >/dev/null 2>&1; then
  echo "yay nicht gefunden, installiere via pacman..."
  sudo pacman -S --needed --noconfirm yay
fi

echo "yay baseline: prüfe ${#PKGS[@]} Pakete..."
MISSING=()
for p in "${PKGS[@]}"; do
  pacman -Q "$p" >/dev/null 2>&1 || MISSING+=("$p")
done

if [ "${#MISSING[@]}" -eq 0 ]; then
  echo "yay baseline: alle Pakete installiert, nichts zu tun."
  exit 0
fi

echo "yay baseline: installiere ${#MISSING[@]} fehlende Pakete: ${MISSING[*]}"
yay -S --needed --noconfirm "${MISSING[@]}"
