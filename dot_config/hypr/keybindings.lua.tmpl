local mainMod = "SUPER"
local terminal = "ghostty"

hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + Q", hl.dsp.window.close())
hl.bind(mainMod .. " + Space", hl.dsp.exec_cmd("rofi -show drun -modi \"drun,calc\" -kb-mode-next \"Tab\" -kb-element-next \"\" -no-sort -no-history -calc-command \"wl-copy '{result}'\""))
hl.bind(mainMod .. " + L", hl.dsp.exec_cmd("hyprlock"))
hl.bind(mainMod .. " + SHIFT + V", hl.dsp.exec_cmd("cliphist list | rofi -dmenu -display-columns 2 | cliphist decode | wl-copy"))
hl.bind(mainMod .. " + SHIFT + C", hl.dsp.exec_cmd("hyprpicker | wl-copy"))
hl.bind(mainMod .. " + Period", hl.dsp.exec_cmd("rofimoji --action \"copy\""))

hl.bind("SUPER + SHIFT + E", hl.dsp.exec_cmd("hyprctl dispatch exit"))
hl.bind(mainMod .. " + SHIFT + R", hl.dsp.exec_cmd("bash " .. os.getenv("HOME") .. "/.config/hypr/reload.sh"))
hl.bind("SUPER + X", hl.dsp.exec_cmd("echo -e \"No\\nYes\" | rofi -dmenu -p \"Shutdown?\" -mesg \"Are you sure you want to shut down?\" | grep -q \"^Yes$\" && shutdown now"))

for workspace = 1, 10 do
    local key = workspace % 10
    hl.bind(mainMod .. " + " .. key, hl.dsp.focus({ workspace = workspace }))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = workspace }))
end

hl.bind("SUPER + SHIFT + Left", hl.dsp.focus({ direction = "left" }))
hl.bind("SUPER + SHIFT + Right", hl.dsp.focus({ direction = "right" }))
hl.bind("SUPER + SHIFT + Up", hl.dsp.focus({ direction = "up" }))
hl.bind("SUPER + SHIFT + Down", hl.dsp.focus({ direction = "down" }))
hl.bind("SUPER + Left", hl.dsp.window.move({ direction = "left" }))
hl.bind("SUPER + Right", hl.dsp.window.move({ direction = "right" }))
hl.bind("SUPER + Up", hl.dsp.window.move({ direction = "up" }))
hl.bind("SUPER + Down", hl.dsp.window.move({ direction = "down" }))
hl.bind(mainMod .. " + V", hl.dsp.window.float())
hl.bind("SUPER + F", hl.dsp.window.fullscreen())
hl.bind("SUPER + D", hl.dsp.window.fullscreen())

hl.bind("mouse:276", hl.dsp.exec_cmd("wtype -M ctrl t -m ctrl"))
hl.bind("mouse:275", hl.dsp.exec_cmd("wtype -M ctrl w -m ctrl"))

{{- if eq .chezmoi.hostname "blackpanther" }}
hl.bind("F24", hl.dsp.exec_cmd("voxtype record start"))
hl.bind("F24", hl.dsp.exec_cmd("voxtype record stop"), { release = true })
hl.bind("Pause", hl.dsp.exec_cmd("voxtype record start"))
hl.bind("Pause", hl.dsp.exec_cmd("voxtype record stop"), { release = true })
hl.bind("F23", hl.dsp.exec_cmd("voxtype record start --profile opencode --no-auto-submit"))
hl.bind("F23", hl.dsp.exec_cmd("voxtype record stop"), { release = true })
{{- end }}

hl.bind("Print", hl.dsp.exec_cmd("grim -g \"$(slurp)\" - | wl-copy && wl-paste > ~/Pictures/screenshots/Screenshot-$(date +%F_%T).png | dunstify \"Screenshot of the region taken\" -t 1000"))
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("grim - | wl-copy && wl-paste > ~/Pictures/screenshots/Screenshot-$(date +%F_%T).png | dunstify \"Screenshot of whole screen taken\" -t 1000"))
hl.bind("SUPER + SHIFT + T", hl.dsp.exec_cmd("bash ~/.local/bin/devsetup restore"))
