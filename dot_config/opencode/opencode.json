{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@prevalentware/opencode-goal-plugin"],
  "theme": "system",
  "autoupdate": false,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "provider": {
    "aioli": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "options": {
        "baseURL": "https://aioli.nig.gl/v1"
      },
      "models": {
        "Qwen/Qwen3.6-35B-A3B-FP8": {
          "name": "Qwen/Qwen3.6-35B-A3B-FP8"
        }
      }
    }
  }
}
