#!/bin/bash
# volta baseline hash: {{ include "packages/volta.txt" | sha256sum }}
# Deklarative volta-Tools via chezmoi (run_onchange_before).
# Läuft automatisch bei `chezmoi apply`, sobald sich packages/volta.txt ändert.
set -eu

PKG_FILE="{{ .chezmoi.sourceDir }}/packages/volta.txt"
export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
export PATH="$VOLTA_HOME/bin:$PATH"

if ! command -v volta >/dev/null 2>&1; then
  echo "volta nicht gefunden, installiere..."
  curl https://get.volta.sh | bash
fi

mapfile -t TOOLS < <(grep -vE '^\s*(#|$)' "$PKG_FILE" || true)
if [ "${#TOOLS[@]}" -eq 0 ]; then
  echo "volta baseline: keine Tools in $PKG_FILE."
  exit 0
fi

HAVE="$(volta list 2>/dev/null || true)"
for t in "${TOOLS[@]}"; do
  if echo "$HAVE" | grep -qwF "$t"; then
    echo "volta baseline: $t ok."
  else
    echo "volta baseline: installiere $t..."
    volta install "$t"
  fi
done
