#!/bin/bash
# vscode-extensions baseline hash: {{ include "packages/vscode-extensions.txt" | sha256sum }}
# Deklarative VS-Code-Extensions via chezmoi (run_onchange_before).
# Läuft automatisch bei `chezmoi apply`, sobald sich packages/vscode-extensions.txt ändert.
set -eu

PKG_FILE="{{ .chezmoi.sourceDir }}/packages/vscode-extensions.txt"

if ! command -v code >/dev/null 2>&1; then
  echo "vscode baseline: code fehlt (yay-Baseline prüfen), skip."
  exit 0
fi

mapfile -t EXTS < <(grep -vE '^\s*(#|$)' "$PKG_FILE" || true)
if [ "${#EXTS[@]}" -eq 0 ]; then
  echo "vscode baseline: keine Extensions in $PKG_FILE."
  exit 0
fi

INSTALLED="$(code --list-extensions 2>/dev/null || true)"
MISSING=()
for e in "${EXTS[@]}"; do
  echo "$INSTALLED" | grep -qxF "$e" || MISSING+=("$e")
done
echo "vscode baseline: $((${#EXTS[@]} - ${#MISSING[@]}))/${#EXTS[@]} up to date"

if [ "${#MISSING[@]}" -gt 0 ]; then
  echo "vscode baseline: installiere ${#MISSING[@]}: ${MISSING[*]}"
  for e in "${MISSING[@]}"; do
    code --install-extension "$e"
  done
fi
